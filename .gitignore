# ключи и системное
.env
.env.*
!.env.example
.DS_Store
node_modules/
package.json
package-lock.json
__pycache__/
*.pyc

# черновики — только на Маке, чистятся после выпуска
_черновики/

# готовые видео и большие файлы
5_готовые-видео/**
!5_готовые-видео/**/
!5_готовые-видео/**/.gitkeep
*.mp4
*.mov
*.wav
*.mp3

# материалы выпуска: в git только каталог, источники и вырезки
3_выпуски/*/материалы/настоящие/*
3_выпуски/*/материалы/мемы/*
3_выпуски/*/материалы/музыка/*
3_выпуски/*/материалы/сгенерированные/*
!3_выпуски/*/материалы/*/CATALOG.md
!3_выпуски/*/материалы/*/.gitkeep

# сборка: кадры клипов, рендеры, проверки, логи
3_выпуски/*/сборка/media/*/
3_выпуски/*/сборка/*/_frames/
3_выпуски/*/сборка/*/watch*/
3_выпуски/*/сборка/watch_full/
3_выпуски/*/сборка/*/sfx.wav
3_выпуски/*/сборка/concat.txt
*.log
*.render.json
_frames/
_gif/
